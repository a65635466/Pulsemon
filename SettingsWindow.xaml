<Window x:Class="PulseMon.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PulseMon Settings"
        Width="300"
        Height="190"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False">
    <Border Padding="18"
            Background="#F5F7FA">
        <StackPanel>
            <TextBlock Text="Settings"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="#17202A" />
            <TextBlock Text="Theme"
                       Margin="0,18,0,8"
                       FontSize="13"
                       Foreground="#667085" />

            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="BlackThemeRadioButton"
                             Content="Black"
                             Margin="0,0,18,0"
                             Checked="OnBlackThemeChecked" />
                <RadioButton x:Name="LightThemeRadioButton"
                             Content="Light"
                             Checked="OnLightThemeChecked" />
            </StackPanel>

            <Button Margin="0,22,0,0"
                    Padding="12,8"
                    HorizontalAlignment="Right"
                    Click="OnCloseClicked"
                    Content="Close" />
        </StackPanel>
    </Border>
</Window>
