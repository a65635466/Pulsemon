<Window x:Class="PulseMon.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PulseMon"
        Title="PulseMon"
        SizeToContent="WidthAndHeight"
        Background="Transparent"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#10141D" />
        <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#254EDB" />
        <SolidColorBrush x:Key="CardBackgroundBrush" Color="#1E3EB3" />
        <SolidColorBrush x:Key="BorderBrush" Color="#C49B3E" />
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F8F9FA" />
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#D5DDF5" />
        <SolidColorBrush x:Key="LabelTextBrush" Color="#F8F9FA" />
        <SolidColorBrush x:Key="AccentBrush" Color="#EBC56F" />
        <SolidColorBrush x:Key="SuccessBrush" Color="#EBC56F" />
        <SolidColorBrush x:Key="MutedTrackBrush" Color="#141A23" />
        <SolidColorBrush x:Key="TitleBarBrush" Color="#1E3EB3" />
        <SolidColorBrush x:Key="TitleBarTextBrush" Color="#F8F9FA" />

        <Style x:Key="MetricLabelStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource LabelTextBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontFamily" Value="Consolas" />
        </Style>

        <Style x:Key="MetricValueStyle" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="FontFamily" Value="Consolas" />
        </Style>

        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="5" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Background" Value="{DynamicResource MutedTrackBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid Height="{TemplateBinding Height}">
                            <Border Background="{TemplateBinding Background}" />
                            <Border HorizontalAlignment="Left"
                                    Width="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=ActualWidth}"
                                    RenderTransformOrigin="0,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleX="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Value, Converter={x:Static local:MainWindow.ProgressScaleConverter}}" />
                                </Border.RenderTransform>
                                <Border Background="{TemplateBinding Foreground}" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <Border x:Name="RootPanel"
            Width="380"
            CornerRadius="10"
            Background="{DynamicResource PanelBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="2"
            MouseLeftButtonDown="OnRootPanelMouseLeftButtonDown">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="30" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="{DynamicResource TitleBarBrush}">
                <TextBlock Margin="10,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TitleBarTextBrush}"
                           FontFamily="Consolas"
                           FontSize="11"
                           FontWeight="Bold"
                           Text="PulseMon — System Monitor" />
                <StackPanel Margin="0,0,8,0"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Margin="0,0,5,0" Fill="{DynamicResource AccentBrush}" />
                    <Ellipse Width="8" Height="8" Margin="0,0,5,0" Fill="#FFFFFF40" />
                    <Button Width="18" Height="18" Padding="0" BorderThickness="0" Background="Transparent" Foreground="#FFFDF9" Click="OnHideButtonClicked" Content="×" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,0">
                    <TextBlock Text="GAUGE PAD"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               FontFamily="Consolas"
                               FontSize="18"
                               FontWeight="Bold" />
                    <TextBlock x:Name="UpdatedAtText"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Bottom"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               FontFamily="Consolas"
                               FontSize="10"
                               Text="--:--:--" />
                </Grid>

                <TextBlock x:Name="AlertStatusText"
                           Grid.Row="1"
                           Margin="0,8,0,0"
                           Foreground="#FFF1A8"
                           FontFamily="Consolas"
                           FontSize="10"
                           FontWeight="Bold"
                           TextWrapping="Wrap"
                           Visibility="Collapsed" />

                <Border Grid.Row="2"
                        Padding="10"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1">
                    <StackPanel>
                        <TextBlock x:Name="DeviceModelText" Foreground="{DynamicResource PrimaryTextBrush}" FontFamily="Consolas" FontSize="12" FontWeight="Bold" Text="Device" />
                        <TextBlock x:Name="DeviceCpuText" Margin="0,4,0,0" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="10" Text="CPU" />
                        <TextBlock x:Name="DeviceGpuText" Margin="0,2,0,0" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="10" Text="GPU" />
                    </StackPanel>
                </Border>

                <StackPanel Grid.Row="4">
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /><ColumnDefinition Width="78" /></Grid.ColumnDefinitions>
                        <TextBlock Text="CPU LOAD" Style="{StaticResource MetricLabelStyle}" />
                        <ProgressBar x:Name="CpuProgressBar" Grid.Column="1" />
                        <TextBlock x:Name="CpuUsageText" Grid.Column="2" Style="{StaticResource MetricValueStyle}" Text="0% / N/A" />
                    </Grid>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /><ColumnDefinition Width="78" /></Grid.ColumnDefinitions>
                        <TextBlock Text="MEMORY" Style="{StaticResource MetricLabelStyle}" />
                        <ProgressBar x:Name="MemoryProgressBar" Grid.Column="1" Foreground="{DynamicResource SuccessBrush}" />
                        <TextBlock x:Name="MemoryUsageText" Grid.Column="2" Style="{StaticResource MetricValueStyle}" Text="- / - GB" />
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /><ColumnDefinition Width="78" /></Grid.ColumnDefinitions>
                        <TextBlock Text="GPU UTIL" Style="{StaticResource MetricLabelStyle}" />
                        <ProgressBar x:Name="GpuProgressBar" Grid.Column="1" />
                        <TextBlock x:Name="GpuStatusText" Grid.Column="2" Style="{StaticResource MetricValueStyle}" Text="N/A" />
                    </Grid>
                </StackPanel>

                <Border Grid.Row="6"
                        Padding="10"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1">
                    <Grid>
                        <TextBlock Foreground="{DynamicResource SecondaryTextBrush}" FontFamily="Consolas" FontSize="9" FontWeight="Bold" Text="SENSORS" />
                        <TextBlock x:Name="SensorStatusText" HorizontalAlignment="Right" Foreground="{DynamicResource AccentBrush}" FontFamily="Consolas" FontSize="10" Text="CPU N/A / GPU N/A / FAN N/A" />
                    </Grid>
                </Border>

                <Border Grid.Row="8"
                        Padding="10"
                        Background="#F8F9FA"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1">
                    <Grid>
                        <StackPanel>
                            <TextBlock Foreground="#254EDB" FontFamily="Consolas" FontSize="9" FontWeight="Bold" Text="NETWORK STREAM" />
                            <TextBlock x:Name="NetworkSpeedText" Margin="0,4,0,0" Foreground="#254EDB" FontFamily="Consolas" FontSize="12" FontWeight="Bold" Text="D - Mbps    U - Mbps" />
                        </StackPanel>
                        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#C49B3E" FontFamily="Consolas" FontSize="9" FontWeight="Bold" Text="ONLINE" />
                    </Grid>
                </Border>

                <Border Grid.Row="10"
                        Padding="10"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1">
                    <Grid>
                        <StackPanel>
                            <TextBlock Foreground="{DynamicResource PrimaryTextBrush}" FontFamily="Consolas" FontSize="9" FontWeight="Bold" Text="BATTERY" />
                            <TextBlock x:Name="BatteryStatusText" Margin="0,4,0,0" Foreground="{DynamicResource SecondaryTextBrush}" FontFamily="Consolas" FontSize="11" Text="N/A" />
                        </StackPanel>
                        <TextBlock x:Name="BatteryPercentText" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}" FontFamily="Consolas" FontSize="14" FontWeight="Bold" Text="N/A" />
                    </Grid>
                </Border>

                <Border Grid.Row="12"
                        Padding="10"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1">
                    <StackPanel>
                        <Grid>
                            <TextBlock Foreground="{DynamicResource PrimaryTextBrush}" FontFamily="Consolas" FontSize="9" FontWeight="Bold" Text="LAST 60 SECONDS" />
                            <TextBlock x:Name="HistorySampleText" HorizontalAlignment="Right" Foreground="{DynamicResource SecondaryTextBrush}" FontFamily="Consolas" FontSize="9" Text="0 samples" />
                        </Grid>
                        <Canvas x:Name="UsageChartCanvas" Height="72" Margin="0,8,0,0" Background="{DynamicResource MutedTrackBrush}" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Foreground="{DynamicResource SecondaryTextBrush}" FontFamily="Consolas" FontSize="9" Text="CPU" />
                            <TextBlock Grid.Column="1" HorizontalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" FontFamily="Consolas" FontSize="9" Text="MEMORY" />
                            <TextBlock Grid.Column="2" HorizontalAlignment="Right" Foreground="{DynamicResource SecondaryTextBrush}" FontFamily="Consolas" FontSize="9" Text="GPU" />
                        </Grid>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Row="14" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Margin="0,0,6,0" Click="OnCopyDeviceInfoClicked" Content="Copy device info" />
                    <Button Click="OnExportCsvClicked" Content="Export CSV" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
